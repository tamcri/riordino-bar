+type CompactMonthlyPdfRow = {
+  shift_date: string;
+  weekday: string;
+  status_label: string;
+  shift_label: string;
+  note: string;
+  hours: number;
+};
+
+function rowPvLabel(row: MonthlyRow) {
+  return pvLabel(row.pv_code, row.pv_name);
+}
+
+function compactShiftLine(row: MonthlyRow) {
+  if (!row.has_shift || !row.status) return "-";
+
+  if (row.status === "rest" || row.status === "vacation" || row.status === "sick") {
+    return `${rowPvLabel(row)}: ${shiftStatusLabel(row.status)}`;
+  }
+
+  const label = rowShiftTime(row);
+  return label && label !== "-" ? label : `${rowPvLabel(row)}: ${shiftStatusLabel(row.status)}`;
+}
+
+function uniqueNonEmpty(values: string[]) {
+  return Array.from(new Set(values.map((value) => value.trim()).filter(Boolean)));
+}
+
+function buildCompactMonthlyPdfRows(rows: MonthlyRow[]): CompactMonthlyPdfRow[] {
+  const byDate = new Map<string, MonthlyRow[]>();
+
+  for (const row of rows) {
+    const current = byDate.get(row.shift_date) ?? [];
+    current.push(row);
+    byDate.set(row.shift_date, current);
+  }
+
+  return Array.from(byDate.entries())
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([date, dayRows]) => {
+      const sortedRows = [...dayRows].sort((a, b) => {
+        const pvCompare = `${a.pv_code ?? ""} ${a.pv_name ?? ""}`.localeCompare(`${b.pv_code ?? ""} ${b.pv_name ?? ""}`, "it");
+        if (pvCompare !== 0) return pvCompare;
+        return `${a.employee_name ?? ""}`.localeCompare(`${b.employee_name ?? ""}`, "it");
+      });
+
+      const statusLabels = uniqueNonEmpty(
+        sortedRows.map((row) => (row.status ? shiftStatusLabel(row.status) : "Nessun turno"))
+      );
+      const shiftLines = uniqueNonEmpty(sortedRows.map((row) => compactShiftLine(row)));
+      const noteLines = uniqueNonEmpty(
+        sortedRows
+          .filter((row) => row.note.trim())
+          .map((row) => `${rowPvLabel(row)}: ${row.note.trim()}`)
+      );
+
+      return {
+        shift_date: date,
+        weekday: sortedRows[0]?.weekday ?? weekdayLabel(date),
+        status_label: statusLabels.join(" / ") || "Nessun turno",
+        shift_label: shiftLines.join("\n") || "-",
+        note: noteLines.join("\n") || "-",
+        hours: sortedRows.reduce((sum, row) => sum + Number(row.hours || 0), 0),
+      };
+    });
+}
